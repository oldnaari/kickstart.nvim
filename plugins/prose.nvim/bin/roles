#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# # Pinned so every machine gets the versions this was tested with. torch is
# # fill's pin, so the two tools share one download.
# dependencies = ["stanza==1.15.0", "torch==2.15.0", "transformers==5.22.2"]
#
# # PyPI's Linux torch wheels pull in CUDA, several GB. The CPU build is enough.
# [[tool.uv.index]]
# name = "pytorch-cpu"
# url = "https://download.pytorch.org/whl/cpu"
# explicit = true
#
# [tool.uv.sources]
# torch = [{ index = "pytorch-cpu", marker = "sys_platform == 'linux'" }]
# ///
"""Mark who does what to whom: subjects, actions, objects and other nouns.

A dependency parser (Stanza) reads each paragraph and labels its words. English,
Russian and Armenian are told apart by their letters, per paragraph.

    roles --show < draft.md      # read text, print it with [brackets]S
    roles --show --flags < x.md  # the same, listing the pattern flags
    roles --daemon SOCKET        # the shared parser that every Neovim uses
    roles                        # the same JSON lines on stdin and stdout

The JSON protocol: each input line is a paragraph, {"id": ..., "text": "..."},
or a list of them. A list is parsed in bulk, about five times faster. Each
paragraph gets its own output line, {"id": ..., "lang": "en", "spans": [[start,
end, role], ...], "flags": [[start, end, code, message], ...], "lead": [start,
end, form] or null, "acronyms": [[start, end, word, defined], ...]} or {"id":
..., "error": "..."}. start and end are UTF-8 byte offsets into text; role is
one of subject, action, object, noun. Flags are the bad-pattern checks of
patterns/prose_patterns.py, which also explains lead and acronyms. A paragraph
with no letters gets lang null and nothing else.

The shared parser speaks it over a Unix socket, to any number of Neovims at
once, taking their requests in turn. It also answers {"cmd": "status"} and
{"cmd": "stop"}, and may send {"notice": "..."} (a model is downloading) and
{"bye": "..."} (it is about to close the connection). Each language stays
loaded for its --keep-alive after its last use; English, by default, for good.
It runs until stopped, and hands over to a fresh process when this file
changes. Its output belongs in a log file: Neovim passes one.

Roles are grammatical, not semantic: in "The bug was fixed by Ann" the subject
is "bug". A sentence can lack one: imperatives have no subject word, Armenian
leaves it out when the verb ending says it, Russian "Он — врач" has no verb.

Models download once into Stanza's cache ($STANZA_RESOURCES_DIR, by default
~/Library/Caches/stanza on macOS and ~/.cache/stanza on Linux) and load offline
after that: about 300 MB each for English and Russian, and for Armenian 600 MB
plus a 1 GB transformer (xlm-roberta-base, into the Hugging Face cache). With
all three loaded the process takes about 2 GB of memory.
"""

import argparse
import asyncio
import contextlib
import ctypes
import fcntl
import gc
import hashlib
import json
import os
import re
import signal
import stat
import sys
import time
import unicodedata
from collections import deque
from concurrent.futures import ThreadPoolExecutor

# The pattern checks live beside the word lists they read, in ../patterns.
PATTERNS = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "patterns")
sys.path.insert(0, PATTERNS)
import prose_patterns  # noqa: E402

# Stanza adds mwt (multi-word tokens, "don't" = do + n't) where a language has it.
PROCESSORS = "tokenize,pos,lemma,depparse"

# Stanza package per language, overridable as ROLES_PACKAGE_EN and so on.
# Armenian has the least training data, and its default package got the roles
# right in 15 of 20 test sentences; the transformer-based one in 19 of 20.
# English and Russian were right throughout with the default.
PACKAGES = {"en": "default", "ru": "default", "hy": "default_accurate"}


def package(lang):
    return os.environ.get(f"ROLES_PACKAGE_{lang.upper()}") or PACKAGES[lang]


# Children that belong to a subject's or object's core phrase: articles,
# adjectives, numbers, possessors, the parts of compounds and names. Not
# prepositional phrases or clauses.
CORE = {"det", "det:poss", "amod", "nummod", "compound", "flat", "flat:name", "flat:foreign", "nmod:poss"}

# Children that are part of the action: auxiliaries, phrasal particles.
ACTION_PARTS = {"aux", "aux:pass", "compound:prt"}

# Negation that is a separate word: "not", "не". (Armenian negates the
# auxiliary itself, "չեմ", which ACTION_PARTS already takes.)
NEGATION = {"not", "n't", "never", "не", "ни"}

# A participle used as an adjective is not an action: "the written text".
NOT_ACTION = {"amod", "compound", "flat", "fixed", "det"}


# --- language ---------------------------------------------------------------


def detect(text):
    """(lang, letters): 'hy', 'ru' or 'en' by the majority of letters, and how
    many letters voted for it. lang is None if there are no letters.

    "x" does not vote: Neovim masks inline code and links as runs of x, which
    would otherwise outvote a short Armenian or Russian sentence."""
    counts = {"hy": 0, "ru": 0, "en": 0}
    for ch in text:
        o = ord(ch)
        if 0x0531 <= o <= 0x0587 or 0xFB13 <= o <= 0xFB17:
            counts["hy"] += 1
        elif 0x0400 <= o <= 0x04FF:
            counts["ru"] += 1
        elif ch.isalpha() and ch.isascii() and ch not in "xX":
            counts["en"] += 1
    lang = max(counts, key=counts.get)
    return (lang if counts[lang] else None), counts[lang]


# A paragraph can switch language between sentences: an Armenian note that
# quotes an English line. It is cut only where the language changes, so the
# usual one-language paragraph is parsed whole.
SENTENCE_END = re.compile(r"(?<=[.!?\u0589\u2026])\s+")
# A sentence with fewer letters than this ("OK.", "1.") says little about its
# language and joins its neighbour's run.
MIN_LETTERS = 4


def runs(text):
    """[(lang, start, end)]: runs of sentences in one language, as character
    offsets into text. Empty when text has no letters."""
    out = []  # [lang, start, end, letters]
    pos = 0
    bounds = [m.end() for m in SENTENCE_END.finditer(text)] + [len(text)]
    for end in bounds:
        if end <= pos:
            continue
        lang, n = detect(text[pos:end])
        if out and (lang is None or n < MIN_LETTERS or lang == out[-1][0]):
            out[-1][2] = end
            out[-1][3] += n if lang == out[-1][0] else 0
        else:
            out.append([lang, pos, end, n])
        pos = end
    # A weak first run ("OK. Это работает.") joins the next one.
    if len(out) > 1 and (out[0][0] is None or out[0][3] < MIN_LETTERS):
        out[1][1] = out[0][1]
        out.pop(0)
    return [(lang, s, e) for lang, s, e, _ in out if lang]


# Armenian ends sentences with ։ but it is often typed as a colon. One
# character for one, so character offsets do not move.
ARMENIAN_COLON = re.compile(r"(?<=[Ա-և]):(?=\s|$)")


def normalise(text, lang):
    if lang == "hy":
        text = ARMENIAN_COLON.sub("։", text)
    return text


# --- parsing ----------------------------------------------------------------


class Parsers:
    """One Stanza pipeline per language, loaded on first use. The shared parser
    also unloads them again, see expire()."""

    def __init__(self, log, notice=None):
        self.log = log
        # A message for the person waiting: a download takes minutes.
        self.notice = notice or (lambda msg: log(f"roles: {msg}"))
        self.pipelines = {}
        self.used = {}  # lang -> time.monotonic() when its last use ended
        self.reported = set()  # pattern-check errors already logged

    def get(self, lang):
        if lang not in self.pipelines:
            self.pipelines[lang] = self.load(lang)
        # After the load, not before: Armenian takes longer to load than a
        # short keep-alive, and must not count as unused the moment it is ready.
        self.used[lang] = time.monotonic()
        return self.pipelines[lang]

    def due(self, keep_alive):
        """Seconds until the next language is due to unload, or None."""
        now = time.monotonic()
        left = [self.used[lang] + keep_alive[lang] - now for lang in self.pipelines if keep_alive.get(lang) is not None]
        return max(0.0, min(left)) if left else None

    def expire(self, keep_alive):
        """Unload the languages unused for longer than their keep-alive (seconds;
        None keeps them) and give the memory back. Returns the ones unloaded."""
        now = time.monotonic()
        gone = [l for l in self.pipelines if keep_alive.get(l) is not None and now - self.used[l] >= keep_alive[l]]
        for lang in gone:
            del self.pipelines[lang]
        if gone:
            give_back_memory()
        return gone

    def load(self, lang):
        t = time.monotonic()
        pkg = package(lang)
        with quiet_stderr():
            import stanza
            from stanza.resources.common import DEFAULT_MODEL_DIR
        if not os.path.isdir(os.path.join(DEFAULT_MODEL_DIR, lang)):
            self.notice(f"downloading the Stanza model for {lang} (one time)...")
        with quiet_stderr():
            pipeline = stanza.Pipeline(
                lang=lang,
                package=pkg,
                processors=PROCESSORS,
                download_method=stanza.DownloadMethod.REUSE_RESOURCES,
                logging_level="ERROR",
                use_gpu=False,
            )
        self.log(f"roles: loaded {lang} ({pkg}) in {time.monotonic() - t:.1f}s")
        return pipeline

    def parse(self, lang, texts):
        """Stanza documents for texts, all in one language, parsed in bulk."""
        pipeline = self.get(lang)
        import stanza

        try:
            return pipeline.bulk_process([stanza.Document([], text=normalise(t, lang)) for t in texts])
        finally:
            self.used[lang] = time.monotonic()


def give_back_memory():
    """Hand freed memory back to the system. Dropping a model frees it inside
    the process, but the allocator keeps much of it for reuse unless asked.
    Measured on macOS: unloading Armenian and Russian took the process from
    1.7 GB to 1.2 GB, and this call on to 0.8 GB, the same as English alone."""
    gc.collect()
    try:
        libc = ctypes.CDLL(None)
        if sys.platform == "darwin":
            libc.malloc_zone_pressure_relief(None, 0)
        else:
            libc.malloc_trim(0)
    except (OSError, AttributeError):
        pass  # another libc: the memory is still reused by the next load


@contextlib.contextmanager
def quiet_stderr():
    """Silence fd 2: Stanza and torch print warnings and progress bars."""
    sys.stderr.flush()
    real = os.dup(2)
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, 2)
    try:
        yield real
    finally:
        sys.stderr.flush()
        os.dup2(real, 2)
        os.close(devnull)
        os.close(real)


def word_range(word):
    """Character range of a word. Words inside a multi-word token ("don't" is
    do + n't) have no range of their own, so they take the token's."""
    if word.start_char is not None:
        return word.start_char, word.end_char
    return word.parent.start_char, word.parent.end_char


def sentence_roles(sent):
    """[(start_char, end_char, role)] for one sentence."""
    words = {w.id: w for w in sent.words}
    children = {i: [] for i in words}
    for w in sent.words:
        if w.head:
            children[w.head].append(w)

    def base(rel):
        return (rel or "").split(":")[0]

    def descendants(i):
        out, stack = set(), [i]
        while stack:
            for c in children[stack.pop()]:
                out.add(c.id)
                stack.append(c.id)
        return out

    def phrase(head, keep):
        """The head with its `keep` children (and theirs), if they form one
        unbroken run of the head's own words; otherwise the head alone."""
        ids, stack = {head.id}, [head.id]
        while stack:
            for c in children[stack.pop()]:
                if c.deprel in keep:
                    ids.add(c.id)
                    stack.append(c.id)
        lo, hi = min(ids), max(ids)
        inside = descendants(head.id) | {head.id}
        if not all(i in inside for i in range(lo, hi + 1)):
            lo = hi = head.id
        return list(range(lo, hi + 1))

    taken = {}  # word id -> role
    spans = []

    def mark(ids, role):
        ids = [i for i in ids if i not in taken]
        if not ids:
            return
        for i in ids:
            taken[i] = role
        # One span per unbroken run of ids.
        run = [ids[0]]
        for i in ids[1:] + [None]:
            if i is not None and i == run[-1] + 1:
                run.append(i)
                continue
            s, _ = word_range(words[run[0]])
            _, e = word_range(words[run[-1]])
            spans.append((s, e, role))
            run = [i]

    # Subjects and objects, then whatever they are conjoined with: in "Ann and
    # Bob", Bob is a conj of Ann and a subject too.
    heads = []
    for w in sent.words:
        rel = base(w.deprel)
        if rel == "nsubj":
            heads.append((w, "subject"))
        elif rel in ("obj", "iobj"):
            heads.append((w, "object"))
        elif w.deprel == "compound:lvc" and w.upos == "NOUN":
            # Armenian marks a bare object noun as part of the verb: "նամակ
            # եմ գրում" (I write letters). Read, it is still the object.
            heads.append((w, "object"))
    i = 0
    while i < len(heads):
        w, role = heads[i]
        heads.extend((c, role) for c in children[w.id] if c.deprel == "conj")
        i += 1
    for w, role in heads:
        mark(phrase(w, CORE), role)

    # Actions: verbs that head a clause, with their auxiliaries, particles and
    # negation; and the copula, the verb of "The code is slow". Each word is
    # marked on its own, since "did not write" has words in between.
    for w in sent.words:
        is_verb = w.upos == "VERB" and w.deprel not in NOT_ACTION
        is_copula = base(w.deprel) == "cop"
        if not (is_verb or is_copula):
            continue
        ids = [w.id]
        if is_verb:
            for c in children[w.id]:
                if c.deprel in ACTION_PARTS or (base(c.deprel) == "advmod" and (c.lemma or c.text).lower() in NEGATION):
                    ids.append(c.id)
        mark(sorted(ids), "action")

    # Every other noun, with the rest of its compound or name ("New York").
    for w in sent.words:
        if w.upos in ("NOUN", "PROPN") and w.id not in taken:
            mark(phrase(w, {"compound", "flat", "flat:name", "flat:foreign"}), "noun")

    return spans


def analyse(parsers, paras):
    """Yield (index, {"id", "lang", "spans"} or {"id", "error"}) for paragraphs
    [{"id", "text"}]. lang is the paragraph's main language. Each language's
    text is parsed together, in bulk, and a paragraph is yielded as soon as all
    its languages are done: English need not wait for the Armenian model."""
    jobs = {}  # lang -> [(paragraph index, run start, run text)]
    left = {}  # paragraph index -> runs not yet parsed
    found = {}  # paragraph index -> character spans so far
    flags = {}  # paragraph index -> character flags so far
    acronyms = {}
    leads = {}  # paragraph index -> (run start, lead): the first run's wins
    errors = {}
    main = {}
    for i, p in enumerate(paras):
        rs = runs(p["text"])
        if not rs:
            yield i, {"id": p.get("id"), "lang": None, "spans": [], "flags": [], "lead": None, "acronyms": []}
            continue
        left[i], found[i], flags[i], acronyms[i] = len(rs), [], [], []
        main[i] = max(rs, key=lambda r: r[2] - r[1])[0]
        for lang, s, e in rs:
            jobs.setdefault(lang, []).append((i, s, p["text"][s:e]))

    for lang, items in jobs.items():
        try:
            docs = parsers.parse(lang, [t for _, _, t in items])
            for (i, s, t), doc in zip(items, docs):
                found[i].extend((a + s, b + s, role) for a, b, role in char_spans(doc, t, lang))
                res = patterns(parsers, doc, t, lang)
                flags[i].extend((a + s, b + s, *rest) for a, b, *rest in res["flags"])
                acronyms[i].extend((a + s, b + s, *rest) for a, b, *rest in res["acronyms"])
                if res["lead"] and (i not in leads or s < leads[i][0]):
                    a, b, form = res["lead"]
                    leads[i] = (s, (a + s, b + s, form))
        except Exception as e:  # report and keep serving: one bad batch is not fatal
            for i, _, _ in items:
                errors[i] = f"{type(e).__name__}: {e}"
        for i, _, _ in items:
            left[i] -= 1
            if left[i] == 0:
                p = paras[i]
                if i in errors:
                    yield i, {"id": p.get("id"), "error": errors[i]}
                else:
                    text = p["text"]
                    yield i, {
                        "id": p.get("id"),
                        "lang": main[i],
                        "spans": to_bytes(text, found[i]),
                        "flags": to_bytes(text, flags[i]),
                        "lead": to_bytes(text, [leads[i][1]])[0] if i in leads else None,
                        "acronyms": to_bytes(text, acronyms[i]),
                    }


def patterns(parsers, doc, text, lang):
    """The pattern checks for one parsed run. A bug in a check must not cost
    the roles, so it is logged once and the run gets no flags."""
    try:
        return prose_patterns.detect(doc, text, lang, parsers.notice)
    except Exception as e:
        msg = f"pattern checks failed: {type(e).__name__}: {e}"
        if msg not in parsers.reported:
            parsers.reported.add(msg)
            import traceback

            parsers.log(f"roles: {msg}\n{traceback.format_exc()}")
        return {"flags": [], "lead": None, "acronyms": []}


def char_spans(doc, text, lang):
    """[(start, end, role)] in character offsets for one parsed run of text."""
    spans = [span for sent in doc.sentences for span in sentence_roles(sent)]
    if lang == "hy":
        spans = attach_endings(text, spans)
    return spans


def to_bytes(text, items):
    """[(start, end, ...)] in character offsets to UTF-8 byte offsets, the rest
    of each item kept: Armenian and Cyrillic letters are two bytes each."""
    byte_at = [0]
    for ch in text:
        byte_at.append(byte_at[-1] + len(ch.encode()))
    return sorted([byte_at[s], byte_at[e], *rest] for s, e, *rest in items)


# "Google-ը", "API-ի": the tokenizer splits an Armenian ending written after a
# hyphen from its word. Whichever half got a role, the span takes in the other.
ENDING_AFTER = re.compile(r"-[\u0531-\u0587]+")
WORD_BEFORE = re.compile(r"[^\s\u0531-\u0587-]+-$")
PRIORITY = {"subject": 0, "object": 0, "action": 1, "noun": 2}


def attach_endings(text, spans):
    grown = []
    for s, e, role in spans:
        m = ENDING_AFTER.match(text, e)
        if m:
            e = m.end()
        m = WORD_BEFORE.search(text, max(0, s - 64), s)
        if m and text[s : s + 1].isalpha() and not text[s].isascii():
            s = m.start()
        grown.append((s, e, role))
    # A grown span can now cover a neighbour: keep the higher-priority one.
    grown.sort(key=lambda x: (PRIORITY[x[2]], x[0]))
    kept = []
    for s, e, role in grown:
        if not any(ks < e and s < ke for ks, ke, _ in kept):
            kept.append((s, e, role))
    return kept


# --- front ends -------------------------------------------------------------


def requested(req):
    """The paragraphs a decoded request asks for, or ValueError."""
    paras = [req] if isinstance(req, dict) else req
    if not isinstance(paras, list) or not all(isinstance(p, dict) and isinstance(p.get("text"), str) for p in paras):
        raise ValueError('expected {"id", "text"} or a list of them')
    return paras


def serve(parsers):
    """JSON lines until stdin closes; see the protocol at the top."""
    def reply(obj):
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            paras = requested(json.loads(line))
        except ValueError as e:
            reply({"id": None, "error": f"bad request: {e}"})
            continue
        for _, out in analyse(parsers, paras):
            reply(out)


# --- the shared parser ------------------------------------------------------

# How long each language stays loaded after its last use: "forever", "0" (unload
# straight after), or a number with s, m or h. English, the usual case, loads at
# start and stays. Reloading costs about 5 s for Russian and 12 s for Armenian.
KEEP_ALIVE = "en=forever,ru=30m,hy=30m"

LOG_LIMIT = 1 << 20  # the log is cut back to nothing past this, at start
SOURCE = os.path.abspath(__file__)


def parse_keep_alive(spec):
    """{"en": None, "ru": 1800.0}: seconds, None for forever."""
    out = {}
    for item in filter(None, (s.strip() for s in spec.split(","))):
        lang, _, value = item.partition("=")
        value = value.strip()
        if value in ("forever", "-1"):
            out[lang.strip()] = None
            continue
        m = re.fullmatch(r"(\d+(?:\.\d+)?)([smh]?)", value)
        if not m:
            raise argparse.ArgumentTypeError(f"bad keep-alive {item!r}: use forever, 0, 90s, 30m or 2h")
        out[lang.strip()] = float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[m.group(2)]
    return out


def duration(seconds):
    if seconds is None:
        return "forever"
    for unit, size in (("h", 3600), ("m", 60)):
        if seconds >= size and seconds % size == 0:
            return f"{seconds / size:g}{unit}"
    return f"{seconds:g}s"


def source_hash():
    """Of this file and the pattern checks: a change to either needs a fresh
    process. The word lists are reread as they change, so they are not here."""
    h = hashlib.sha256()
    try:
        for path in (SOURCE, prose_patterns.__file__):
            with open(path, "rb") as f:
                h.update(f.read())
    except OSError:
        return None
    return h.hexdigest()


class Client:
    """One connected Neovim and the requests it has queued."""

    def __init__(self, writer):
        self.writer = writer
        self.jobs = deque()

    def send(self, obj):
        if not self.writer.is_closing():
            self.writer.write((json.dumps(obj, ensure_ascii=False) + "\n").encode())


class Daemon:
    """The shared parser. Requests are taken from each client in turn, so one
    Neovim opening a long file does not hold up another's edit. Stanza runs on
    a single worker thread; the event loop only moves messages."""

    def __init__(self, path, keep_alive, log):
        self.path = path
        self.keep_alive = keep_alive
        self.log = log
        self.parsers = Parsers(log, self.notice)
        self.worker = ThreadPoolExecutor(max_workers=1)
        self.clients = deque()  # in turn order
        self.source = source_hash()
        self.started = time.time()
        self.closing = False
        self.server = None

    async def run(self):
        self.loop = asyncio.get_running_loop()
        self.wake = asyncio.Event()
        self.done = asyncio.Event()
        for sig in (signal.SIGTERM, signal.SIGINT):
            self.loop.add_signal_handler(sig, self.shutdown, "signal")
        # A batch of long paragraphs is one line, well past the 64 KB default.
        self.server = await asyncio.start_unix_server(self.handle, self.path, limit=1 << 24)
        self.log(f"roles: shared parser {os.getpid()} listening, keep-alive {self.describe_keep_alive()}")
        self.loop.create_task(self.schedule())
        await self.done.wait()
        await asyncio.sleep(0.2)  # let the goodbyes reach the clients

    def describe_keep_alive(self):
        return ", ".join(f"{lang} {duration(s)}" for lang, s in self.keep_alive.items())

    def work(self, fn, *args):
        return self.loop.run_in_executor(self.worker, fn, *args)

    async def schedule(self):
        await self.work(self.preload)
        while not self.closing:
            job = self.next_job()
            if job:
                await self.work(self.parse, *job)
            else:
                self.wake.clear()
                with contextlib.suppress(asyncio.TimeoutError):
                    await asyncio.wait_for(self.wake.wait(), self.parsers.due(self.keep_alive))
            for lang in await self.work(self.parsers.expire, self.keep_alive):
                self.log(f"roles: unloaded {lang}, unused for {duration(self.keep_alive[lang])}")

    def preload(self):
        for lang, keep in self.keep_alive.items():
            if keep is None:
                try:
                    self.parsers.get(lang)
                except Exception as e:  # it loads again on first use, or reports then
                    self.log(f"roles: could not load {lang}: {type(e).__name__}: {e}")

    def next_job(self):
        for _ in range(len(self.clients)):
            client = self.clients[0]
            self.clients.rotate(-1)
            if client.jobs:
                return client, client.jobs.popleft()
        return None

    def parse(self, client, paras):
        """On the worker thread. Results go back one paragraph at a time."""
        try:
            for _, out in analyse(self.parsers, paras):
                self.loop.call_soon_threadsafe(client.send, out)
        except Exception as e:  # analyse reports errors per paragraph; this is a bug
            self.log(f"roles: {type(e).__name__}: {e}")
            for p in paras:
                self.loop.call_soon_threadsafe(client.send, {"id": p.get("id"), "error": f"{type(e).__name__}: {e}"})

    def notice(self, msg):
        """From the worker thread: log it and tell everyone connected."""
        self.log(f"roles: {msg}")
        self.loop.call_soon_threadsafe(lambda: [c.send({"notice": msg}) for c in self.clients])

    async def handle(self, reader, writer):
        client = Client(writer)
        if source_hash() != self.source:
            # bin/roles was edited or updated: make way for a fresh process,
            # which the client starts when it finds no one listening.
            client.send({"bye": "restart"})
            self.shutdown("bin/roles changed")
            writer.close()
            return
        self.clients.append(client)
        try:
            while not self.closing:
                line = await reader.readline()
                if not line:
                    break
                self.receive(client, line)
        except (ConnectionError, ValueError) as e:  # ValueError: a line over the limit
            self.log(f"roles: dropped a client: {e}")
        finally:
            client.jobs.clear()
            with contextlib.suppress(ValueError):
                self.clients.remove(client)
            writer.close()

    def receive(self, client, line):
        if not line.strip():
            return
        try:
            req = json.loads(line)
            if isinstance(req, dict) and "cmd" in req:
                return self.command(client, req["cmd"])
            client.jobs.append(requested(req))
            self.wake.set()
        except ValueError as e:
            client.send({"id": None, "error": f"bad request: {e}"})

    def command(self, client, cmd):
        if cmd == "status":
            now, used = time.monotonic(), dict(self.parsers.used)
            client.send({"status": {
                "pid": os.getpid(),
                "started": self.started,
                "clients": sum(1 for c in self.clients if c is not client),  # besides the asker
                "queued": sum(len(c.jobs) for c in self.clients),
                "loaded": {lang: round(now - used.get(lang, now)) for lang in list(self.parsers.pipelines)},
                "keep_alive": {lang: duration(s) for lang, s in self.keep_alive.items()},
            }})
        elif cmd == "stop":
            self.shutdown("stopped")
        else:
            raise ValueError(f"unknown command {cmd!r}")

    def shutdown(self, reason):
        if self.closing:
            return
        self.closing = True
        self.log(f"roles: shutting down: {reason}")
        if self.server:
            self.server.close()
        # Gone before the clients hear about it, so a client that reconnects at
        # once finds no one and starts a fresh process.
        with contextlib.suppress(FileNotFoundError):
            os.unlink(self.path)
        for c in list(self.clients):
            c.send({"bye": reason})
            c.writer.close()
        self.done.set()


def take_lock(path, wait=5.0):
    """An exclusive lock held for the process's life, or None if another shared
    parser has it. Waits a little: a parser making way for a new version lets
    go only as it exits."""
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.monotonic() + wait
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() > deadline:
                os.close(fd)
                return None
            time.sleep(0.1)


def daemon(path, keep_alive):
    os.umask(0o077)  # the socket, lock and log are for this user alone
    lock = take_lock(path + ".lock")
    if lock is None:
        return  # another one is running; quietly leave it to that one
    if stat.S_ISREG(os.fstat(2).st_mode) and os.fstat(2).st_size > LOG_LIMIT:
        os.ftruncate(2, 0)

    def log(msg):
        print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}", file=sys.stderr, flush=True)

    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)  # left behind by a parser that crashed: the lock is ours
    asyncio.run(Daemon(path, keep_alive, log).run())
    sys.stdout.flush()
    sys.stderr.flush()
    # Not sys.exit: that would wait for the worker thread to finish a parse,
    # or a model load, that nobody is waiting for any more.
    os._exit(0)


TAGS = {"subject": "S", "action": "A", "object": "O", "noun": "N"}


def show(parsers, text, nouns, flags=False):
    """Print each paragraph with its roles in brackets: [The old man]S. With
    flags, list the pattern flags under it instead."""
    paras = [{"text": p} for p in re.split(r"\n\s*\n", text) if p.strip()]
    results = dict(analyse(parsers, paras))
    for i, para in enumerate(paras):
        res = results[i]
        if "error" in res:
            print(f"error: {res['error']}")
            continue
        raw = para["text"].encode()
        if flags:
            print(f"{res['lang']}: {para['text'].strip()}")
            for s, e, code, message in res["flags"]:
                print(f"  {code:<16} [{raw[s:e].decode()}] {message}")
            if res["lead"]:
                s, e, form = res["lead"]
                print(f"  {'(lead)':<16} [{raw[s:e].decode()}] {form}")
            for s, e, word, defined in res["acronyms"]:
                print(f"  {'(acronym)':<16} [{word}] {'defined here' if defined else 'not defined here'}")
            continue
        out, pos = [], 0
        for s, e, role in res["spans"]:
            if role == "noun" and not nouns:
                continue
            out.append(raw[pos:s].decode())
            out.append(f"[{raw[s:e].decode()}]{TAGS[role]}")
            pos = e
        out.append(raw[pos:].decode())
        print(f"{res['lang']}: {''.join(out).strip()}")


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--show", action="store_true", help="read text, print it with roles in brackets")
    parser.add_argument("--no-nouns", action="store_true", help="with --show, leave other nouns unmarked")
    parser.add_argument("--flags", action="store_true", help="with --show, list the pattern flags instead")
    parser.add_argument("--daemon", metavar="SOCKET", help="run the shared parser on this Unix socket")
    parser.add_argument(
        "--keep-alive",
        metavar="SPEC",
        type=parse_keep_alive,
        default={},
        help=f"with --daemon, how long each language stays loaded after use (default {KEEP_ALIVE})",
    )
    args = parser.parse_args()

    if args.daemon:
        daemon(args.daemon, {**parse_keep_alive(KEEP_ALIVE), **args.keep_alive})
        return

    def log(msg):
        print(msg, file=sys.stderr, flush=True)

    parsers = Parsers(log)
    if args.show:
        show(parsers, unicodedata.normalize("NFC", sys.stdin.read()), not args.no_nouns, args.flags)
    else:
        serve(parsers)


if __name__ == "__main__":
    main()
